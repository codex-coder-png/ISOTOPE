<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>ISOTOPE — Elemental Arena</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=Share+Tech+Mono&family=Titillium+Web:wght@400;600;700&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>

<body><canvas id="bg"></canvas>
  <div id="app">
    <section class="screen" id="scr-menu">
      <div id="menuwrap">
        <div id="menuleft">
          <div class="brandkick">PERIODIC COMBAT PROTOCOL // REACTOR 7</div>
          <div class="brand">ISO<b>TOPE</b></div>
          <div class="brandsub">ELEMENTAL ARENA</div>
          <div id="menubtns">
            <button class="btn primary" id="btn-deploy">▸ DEPLOY<small>solo / local co-op</small></button>
            <button class="btn" data-go="scr-lobby">ONLINE ARENA<small>lobbies · co-op · pvp</small></button>
            <button class="btn" data-go="scr-vault">PERIODIC VAULT<small>118 elements</small></button>
            <button class="btn" data-go="scr-mastery">ELEMENT MASTERY<small>per-element trees</small></button>
            <button class="btn" data-go="scr-lab">SYNTHESIS LAB<small>real chemistry</small></button>
            <button class="btn" data-go="scr-aug">AUGMENTATIONS<small>permanent upgrades</small></button>
            <button class="btn" data-go="scr-arch">ARCHIVE<small>records</small></button>
            <button class="btn" data-go="scr-set">SETTINGS<small>audio · fx</small></button>
          </div>
          <div id="menufoot"><span>REACTOR ONLINE</span><span>SAVED LOCALLY</span><span>BUILD 4.1</span></div>
        </div>
        <div id="menuright">
          <div id="showcase">
            <div id="big-tile">
              <div class="orb"></div>
              <div class="orb orb2"></div><span class="n" id="bt-n">1</span><span class="s" id="bt-s">H</span><span
                class="nm" id="bt-nm">HYDROGEN</span>
            </div>
            <div id="sel-cat" class="tag">REACTIVE NONMETAL</div>
            <div id="sel-blurb"></div>
            <button class="btn" data-go="scr-vault" style="margin-top:14px">CHANGE ELEMENT</button>
          </div>
        </div>
      </div>
    </section>

    <section class="screen hidden" id="scr-lobby">
      <div class="headrow"><button class="btn" data-go="scr-menu">◂ MENU</button>
        <h2>ONLINE ARENA</h2><span class="sub" id="net-status">peer-to-peer via WebRTC</span>
      </div>
      <div id="lobby-body">
        <div class="panel labcol">
          <h3>HOST A LOBBY</h3>
          <p class="sub">You run the sim, pick the mode, start the match.</p>
          <button class="btn primary" id="btn-host">⬢ HOST LOBBY</button>
          <div id="host-code" class="hidden">
            <div class="codebox" id="code-txt">-----</div>
            <div class="sub">share this code</div>
            <div id="host-wait" class="sub">waiting for player 2…</div>
          </div>
        </div>
        <div class="panel labcol">
          <h3>JOIN A LOBBY</h3><input id="join-in" class="codein" maxlength="5" placeholder="CODE"><button class="btn"
            id="btn-join">▸ JOIN</button>
        </div>
        <div class="panel labcol hidden" id="lob-room">
          <h3>LOBBY <span class="mono" id="room-code"></span></h3>
          <div id="room-players" class="sub"></div>
          <div id="host-opts">
            <div class="sub" style="margin:10px 0 6px">MODE (host)</div>
            <div class="modegrid small">
              <div class="modecard panel2 sel" data-nm="coop"><b>CO-OP</b><span>survive together</span></div>
              <div class="modecard panel2" data-nm="pvp"><b>PVP</b><span>deathmatch</span></div>
            </div>
            <div class="sub" style="margin:8px 0 6px">PVP FRAG TARGET</div>
            <div class="modegrid small" id="fragrow">
              <div class="modecard panel2" data-fr="5"><b>5</b></div>
              <div class="modecard panel2 sel" data-fr="10"><b>10</b></div>
              <div class="modecard panel2" data-fr="15"><b>15</b></div>
            </div>
            <div class="sub"
              style="margin:8px 0 6px;display:flex;align-items:center;justify-content:space-between;gap:10px">
              <span>FRIENDLY FIRE <small style="opacity:.7">(co-op: players can hurt each other)</small></span>
              <div class="tgl" id="tgl-ff"></div>
            </div>
            <div class="sub" style="margin:8px 0">Element: <b id="room-elem"></b> (mirror match)</div>
            <button class="btn primary" id="btn-start">START MATCH ▸</button>
          </div>
          <div id="guest-wait" class="sub hidden">Connected! Waiting for host…</div>
          <button class="btn warn" id="btn-leave" style="margin-top:14px">LEAVE</button>
        </div>
      </div>
    </section>

    <section class="screen hidden" id="scr-vault">
      <div class="headrow"><button class="btn" data-go="scr-menu">◂ MENU</button>
        <h2>PERIODIC VAULT</h2><span class="sp"></span><span class="coinbadge">◈ <b class="coinv">0</b></span>
      </div>
      <div id="vault-body">
        <div id="vault-main">
          <div id="vault-scroll">
            <div id="ptable"></div>
          </div>
          <div id="molstrip"><span class="lbl">SYNTHESIZED ▸</span></div>
        </div>
        <div id="vd" class="panel">
          <div id="vd-tile"><span class="s">?</span></div>
          <div id="vd-name">SELECT</div>
          <div id="vd-cat" class="tag" style="align-self:center">—</div>
          <div id="vd-desc"></div>
          <div id="vd-stats"></div>
          <div id="vd-active" class="panel2"></div><button class="btn primary" id="vd-btn">SELECT</button>
        </div>
      </div>
    </section>

    <section class="screen hidden" id="scr-mastery">
      <div class="headrow"><button class="btn" data-go="scr-menu">◂ MENU</button>
        <h2>ELEMENT MASTERY</h2><span class="sub">earn ◆ by fighting as an element</span><span class="sp"></span><span
          class="tag" id="mxp-badge">◆ 0</span>
      </div>
      <div id="mastery-body">
        <div id="m-elems" class="panel"></div>
        <div id="m-detail" class="panel">
          <div id="m-head"></div>
          <div id="m-tree"></div>
        </div>
      </div>
    </section>

    <section class="screen hidden" id="scr-lab">
      <div class="headrow"><button class="btn" data-go="scr-menu">◂ MENU</button>
        <h2>SYNTHESIS LAB</h2><span class="sub">2–5 reagents · real bonds only</span><span class="sp"></span><span
          class="tag" id="lab-count"></span>
      </div>
      <div id="lab-body">
        <div class="labcol panel">
          <h3>REAGENT SHELF</h3>
          <div id="lab-inv"></div>
        </div>
        <div class="labcol panel" id="reactor">
          <h3 style="text-align:center">BONDING CHAMBER</h3>
          <div id="slots"></div>
          <div style="text-align:center"><button class="btn primary" id="btn-synth">⚗ SYNTHESIZE</button></div>
          <div class="rlabel">— REACTION READOUT —</div>
          <div id="lab-result"><span class="dim">Awaiting reagents…</span></div>
        </div>
        <div class="labcol panel">
          <h3>FORMULA CODEX</h3>
          <div id="lab-book"></div>
        </div>
      </div>
    </section>

    <section class="screen hidden" id="scr-aug">
      <div class="headrow"><button class="btn" data-go="scr-menu">◂ MENU</button>
        <h2>AUGMENTATIONS</h2><span class="sp"></span><span class="coinbadge">◈ <b class="coinv">0</b></span>
      </div>
      <div id="aug-grid"></div>
    </section>

    <section class="screen hidden" id="scr-arch">
      <div class="headrow"><button class="btn" data-go="scr-menu">◂ MENU</button>
        <h2>ARCHIVE</h2>
      </div>
      <div id="arch-stats"></div>
      <h3 class="sechdr">MASTERY CODEX</h3>
      <div id="arch-abil"></div>
      <h3 class="sechdr">ENEMY INTEL</h3>
      <div id="arch-enemy"></div>
      <h3 class="sechdr">WARDEN INTEL (12)</h3>
      <div id="arch-boss"></div>
    </section>

    <section class="screen hidden" id="scr-set">
      <div class="headrow"><button class="btn" data-go="scr-menu">◂ MENU</button>
        <h2>SETTINGS</h2>
      </div>
      <div id="set-rows">
        <div class="setrow panel"><label>SFX VOLUME</label><input type="range" id="set-sfx" min="0" max="100"></div>
        <div class="setrow panel"><label>MUSIC</label>
          <div class="tgl" id="tgl-mus"></div><input type="range" id="set-mus" min="0" max="100">
        </div>
        <div class="setrow panel"><label>SCREEN SHAKE</label>
          <div class="tgl" id="tgl-shake"></div>
        </div>
        <div class="setrow panel"><label>DAMAGE NUMBERS</label>
          <div class="tgl" id="tgl-dmg"></div>
        </div>
        <div class="setrow panel"><label style="color:var(--mg)">WIPE SAVE</label><button class="btn warn"
            id="btn-wipe">ERASE</button></div>
      </div>
    </section>

    <section class="screen hidden" id="scr-game"><canvas id="game"></canvas>
      <div id="hud">
        <div class="hpanel" id="hud-tl">
          <div id="h-elem"><span class="z" id="h-num">1</span><span class="s" id="h-sym">H</span></div>
          <div id="hp-bars"></div>
        </div>
        <div class="hpanel" id="hud-tc">
          <div id="h-wave">WAVE 01</div>
          <div id="h-foes">HOSTILES: 0</div>
          <div id="bosswrap" class="hidden">
            <div id="bossname"></div>
            <div class="bar boss" style="width:340px"><i id="bossfill"></i></div>
          </div>
        </div>
        <div class="hpanel hidden" id="hud-pvp"
          style="top:78px;left:50%;transform:translateX(-50%);min-width:220px;text-align:left">
          <div class="sub" style="margin-bottom:4px;letter-spacing:.2em">SCOREBOARD</div>
          <div id="pvp-scores-list"></div>
        </div>
        <div class="hpanel" id="hud-tr">
          <div id="h-coins">◈ 0</div>
          <div id="h-kills">KILLS 0</div>
          <div id="h-lv">LV 1</div>
          <div id="h-mode" class="dim"></div>
        </div>
        <div id="hud-bl"></div>
        <div id="hud-br">
          <div class="chipkey">
            <div id="dashfill"></div><span>SPACE · DASH</span>
          </div>
          <div class="chipkey">
            <div id="qfill"></div><span>Q · SIGNATURE</span>
          </div>
          <div class="chipkey" id="autofire"><span>F · AUTOFIRE OFF</span></div>
        </div>
        <div id="xpbar">
          <div id="xpfill"></div><span id="xptxt">LV 1</span>
        </div>
        <div id="banner" class="hidden"></div>
      </div>
      <div id="hitflash"></div>
      <div id="lowhp"></div>
      <div class="ov hidden" id="m-deploy">
        <div class="modal panel" style="max-width:520px">
          <h2>DEPLOY</h2>
          <div class="sub" id="dep-elem"></div>
          <div class="modegrid">
            <div class="modecard panel2 sel" data-mode="solo"><b>SOLO</b><span>one operator</span></div>
            <div class="modecard panel2" data-mode="coop"><b>CO-OP</b><span>2P shared keyboard</span></div>
          </div>
          <div class="coophints panel2 mono hidden" id="coop-hints">P1: WASD+MOUSE · Q · SPACE<br>P2: ARROWS · R-SHIFT ·
            ENTER<br>Revive downed partner by standing near.</div>
          <div style="display:flex;gap:12px;justify-content:center"><button class="btn primary" id="dep-go">ENGAGE
              ▸</button><button class="btn" id="dep-cancel">BACK</button></div>
        </div>
      </div>
      <div class="ov hidden" id="m-level">
        <div class="modal panel" style="text-align:center">
          <h2 style="color:var(--cy)">ISOTOPE STABILIZED</h2>
          <div class="sub">select one module</div>
          <div id="cards"></div>
        </div>
      </div>
      <div class="ov hidden" id="m-pause">
        <div class="modal panel" style="text-align:center;max-width:460px">
          <h2>PAUSED</h2>
          <div class="sub mono" id="pause-info"></div>
          <div style="display:flex;flex-direction:column;gap:10px;margin-top:20px"><button class="btn primary"
              id="btn-resume">RESUME</button><button class="btn" id="btn-prestart">RESTART</button><button
              class="btn warn" id="btn-abandon">ABANDON</button></div>
        </div>
      </div>
      <div class="ov hidden" id="m-over">
        <div class="modal panel" style="text-align:center;max-width:480px">
          <h2 style="color:var(--mg)" id="ov-title">DECAYED</h2>
          <div class="sub" id="over-flavor"></div>
          <div style="margin:18px 0;text-align:left" id="ov-rows"></div>
          <div style="display:flex;gap:12px;justify-content:center"><button class="btn primary"
              id="btn-retry">RE-DEPLOY</button><button class="btn" id="btn-tomenu">MAIN MENU</button></div>
        </div>
      </div>
      <div class="ov hidden" id="m-brief">
        <div class="modal panel" style="max-width:560px">
          <h2 style="color:var(--cy)">MISSION BRIEFING</h2>
          <div id="brief-rows"></div>
          <div style="text-align:center;margin-top:20px"><button class="btn primary" id="btn-briefok">ENGAGE ▸</button>
          </div>
        </div>
      </div>
    </section>
    <div id="toasts"></div>
  </div>
  <script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
  <script src="data.js"></script>
  <script src="save.js"></script>
  <script src="audio.js"></script>
  <script src="net.js"></script>
  <script src="game.js"></script>
  <script src="ui.js"></script>
  
  
</body>

</html>